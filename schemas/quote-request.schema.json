{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuyiming-ship-it/ryan-export-quote-engine/schemas/quote-request.schema.json",
  "title": "Export quote request 1.0",
  "type": "object",
  "required": ["schema_version", "quote_id", "quote_date", "valid_until", "currency", "business_mode", "trade_term", "delivery_place", "destination", "payment_terms", "vehicles", "costs", "coverage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["live", "replay"]},
    "quote_id": {"type": "string", "minLength": 1},
    "quote_date": {"type": "string", "format": "date"},
    "valid_until": {"type": "string", "format": "date"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "business_mode": {"enum": ["standard", "central_procurement"]},
    "trade_term": {"enum": ["EXW", "FCA", "FOB", "CFR", "CIF", "CPT", "CIP", "DAP", "DPU", "DDP"]},
    "delivery_place": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "payment_terms": {"type": "string", "minLength": 1},
    "customer_payment": {"type": "object", "properties": {"deposit_rate": {"$ref": "#/$defs/decimal"}, "balance_trigger": {"type": "string"}, "credit_days": {"$ref": "#/$defs/decimal"}, "method": {"type": "string"}}},
    "selected_funder_id": {"type": "string", "minLength": 1},
    "vehicles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "model", "quantity"], "properties": {"id": {"type": "string"}, "model": {"type": "string"}, "quantity": {"type": "integer", "minimum": 1}}}},
    "costs": {"type": "array", "items": {"$ref": "#/$defs/cost"}},
    "fx": {"type": "object", "additionalProperties": {"$ref": "#/$defs/evidenceRate"}},
    "coverage": {"type": "object", "required": ["vehicle", "transport", "funding"], "additionalProperties": {"type": "object", "required": ["status", "reason"], "properties": {"status": {"enum": ["complete", "not_applicable"]}, "reason": {"type": "string", "minLength": 1}}}},
    "profit_target": {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"enum": ["per_vehicle", "total", "margin"]}, "value": {"$ref": "#/$defs/decimal"}}},
    "sale_price": {"allOf": [{"$ref": "#/$defs/evidence"}, {"type": "object", "required": ["amount"], "properties": {"amount": {"$ref": "#/$defs/decimal"}}}]},
    "profit_shares": {"type": "object", "required": ["ours", "upstream"], "properties": {"ours": {"$ref": "#/$defs/decimal"}, "upstream": {"$ref": "#/$defs/decimal"}}},
    "contract_rounding": {"enum": ["cent_half_up", "unit_ceiling", "none"]}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "evidence": {"type": "object", "required": ["source", "status"], "properties": {"source": {"type": "string", "minLength": 1}, "status": {"enum": ["confirmed", "estimated", "pending", "historical", "expired", "conflict"]}, "valid_from": {"type": "string", "format": "date"}, "valid_until": {"type": "string", "format": "date"}}},
    "evidenceRate": {"allOf": [{"$ref": "#/$defs/evidence"}, {"type": "object", "required": ["rate"], "properties": {"rate": {"$ref": "#/$defs/decimal"}}}]},
    "cost": {"allOf": [{"$ref": "#/$defs/evidence"}, {"type": "object", "required": ["id", "component", "name", "category", "amount", "currency", "unit", "allocation", "bearers", "tax_treatment"], "properties": {"id": {"type": "string"}, "component": {"type": "string"}, "name": {"type": "string"}, "category": {"enum": ["vehicle", "transport", "funding"]}, "amount": {"$ref": "#/$defs/decimal"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "unit": {"enum": ["per_vehicle", "per_batch", "per_container", "per_day", "percent", "annual_interest"]}, "allocation": {"enum": ["quantity", "weights"]}, "bearers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}}, "tax_treatment": {"type": "string"}, "included_in": {"type": "string"}, "includes": {"type": "array", "items": {"type": "string"}}, "effect": {"enum": ["cost", "credit"]}, "source_type": {"enum": ["supplier_quote", "company_rule", "manual", "historical"]}, "supplier_id": {"type": "string"}, "supplier_name": {"type": "string"}, "quoted_at": {"type": "string", "format": "date-time"}, "quote_channel": {"type": "string"}, "quote_ref": {"type": "string"}, "owner": {"type": "string"}, "funder_id": {"type": "string"}}}]}
  }
}
